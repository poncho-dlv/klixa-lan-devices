# Exemple smoke_relay.py — chargé par systemd via EnvironmentFile, ou par le shell en
# dev. Copier en .env et remplir. NE PAS committer le .env rempli.
# Format systemd : KEY=value, sans "export", sans guillemets autour des valeurs.

# Adresse du compagnon sur le LAN (PAS l'adresse cloud) — celle où tourne
# klixa-companion, port du serveur local (COMPANION_HOST/PORT côté compagnon).
COMPANION_URL=ws://192.168.1.30:8786/devices/ws

# Token généré depuis l'IHM du compagnon (page « Appareils LAN » → Générer un token).
# DEVICE_ID doit être EXACTEMENT celui saisi à la génération (c'est lui qui est lié au
# token, pas l'inverse) ; DEVICE_NAME est juste un libellé affiché côté Klixa.
DEVICE_TOKEN=
DEVICE_ID=smoke-machine
DEVICE_NAME=Machine à fumée

# Broche du relais (BCM) et bornes de durée d'impulsion (ms).
SMOKE_GPIO_PIN=17
SMOKE_MIN_MS=50
SMOKE_MAX_MS=1500
SMOKE_DEFAULT_MS=300
