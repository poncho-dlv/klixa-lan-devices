[Unit]
Description=Klixa - Agent device (relais machine a fumee)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adapter l'utilisateur et le chemin selon l'installation
User=rpi_user
WorkingDirectory=/home/rpi_user/klixa-device-agent
EnvironmentFile=/home/rpi_user/klixa-device-agent/.env
ExecStart=/usr/bin/python3 /home/rpi_user/klixa-device-agent/smoke_relay.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
