# Adresse du compagnon Klixa (page « Appareils LAN » de l'app Klixa Companion : activer l'accès, générer un token)
COMPANION_URL=ws://127.0.0.1:8786/devices/ws
# Token généré pour l'identifiant d'appareil ci-dessous (affiché une seule fois)
DEVICE_TOKEN=
DEVICE_ID=smallrig
DEVICE_NAME=Lampes SmallRig
# État mesh (clés réseau, lampes appairées, séquences) — SECRET, ne jamais partager ni versionner
SMALLRIG_MESH_STATE_FILE=./smallrig-mesh-state.json
SMALLRIG_MAX_LAMPS=50
SMALLRIG_SEQ_BLOCK_SIZE=100
